{
  "name": "plugin_experiment",
  "version": "0.1.0",
  "private": true,
  "description": "Offline semantic note indexing for Find, Don't Search.",
  "main": "main.js",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "prepare:model": "node scripts/prepare-model.mjs",
    "verify:index": "node scripts/verify.mjs",
    "verify:pipeline": "node scripts/verify-pipeline.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@xenova/transformers": "2.17.2"
  }
}
